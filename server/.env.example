# Copy this file to server/.env and add your real key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional overrides
PORT=3001
GEMINI_MODEL=gemini-3.5-flash-lite

# Needed for real "forgot password" emails to go out. Without it, reset
# links are printed to the server's console instead — handy for local use
# and testing, but you'll want a real key before other people rely on this.
# Free to start at https://resend.com/api-keys
RESEND_API_KEY=your_resend_key_here

# Optional overrides
MAIL_FROM=BudgetBrain <onboarding@resend.dev>
APP_URL=http://localhost:5173

# Only needed once you deploy: a Turso database URL + auth token
# (https://turso.tech). Leave both unset for local development — the app
# falls back to a local SQLite file (server/data/budgetbrain.db) via the
# same @libsql/client driver either way.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
